{
  "name": "quest-gp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:api": "bun --cwd apps/api run dev",
    "prisma:generate": "bun run --cwd apps/api prisma:generate",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "typecheck": "bunx tsc -p apps/api/tsconfig.json --noEmit && bunx tsc -p apps/mobile/tsconfig.json --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0"
  }
}
